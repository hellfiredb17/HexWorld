<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ClanIronSim.CoreUx.WorldBuilder.ViewModels" xmlns:views="using:ClanIronSim.CoreUx.WorldBuilder.Views" x:Class="ClanIronSim.CoreUx.WorldBuilder.Views.MapSectionEditorView" x:DataType="vm:MapSectionEditorViewModel">
  <UserControl.Styles>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#171D23"/><Setter Property="BorderBrush" Value="#2B3641"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/></Style>
    <Style Selector="TextBlock.help"><Setter Property="Foreground" Value="#9DACB8"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="RadioButton"><Setter Property="Foreground" Value="#EEF3F7"/></Style>
    <Style Selector="RadioButton:pointerover"><Setter Property="Background" Value="#24303A"/><Setter Property="Foreground" Value="#EEF3F7"/></Style>
    <Style Selector="RadioButton:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#24303A"/><Setter Property="Foreground" Value="#EEF3F7"/></Style>
    <Style Selector="RadioButton.mode"><Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="#12181E"/><Setter Property="BorderBrush" Value="#2B3641"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="RadioButton.mode:checked"><Setter Property="BorderBrush" Value="#7DD3FC"/><Setter Property="Background" Value="#38BDF8"/><Setter Property="Foreground" Value="#061018"/></Style>
    <Style Selector="RadioButton.mode:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#38BDF8"/><Setter Property="Foreground" Value="#061018"/><Setter Property="BorderBrush" Value="#7DD3FC"/></Style>
    <Style Selector="RadioButton.mode:checked:pointerover"><Setter Property="Background" Value="#7DD3FC"/><Setter Property="Foreground" Value="#061018"/></Style>
    <Style Selector="RadioButton.mode:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#7DD3FC"/><Setter Property="Foreground" Value="#061018"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="72,*,74" Background="#101418">
    <Grid Margin="20,0" ColumnDefinitions="Auto,280,Auto,220,Auto,110,Auto,110,*,Auto,Auto" ColumnSpacing="14">
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Section Editor" FontSize="21" FontWeight="SemiBold"/><TextBlock Classes="help" Text="Assemble a reusable map section from your tiles."/></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="help" Text="Section name"/><TextBox Text="{Binding Name}"/></StackPanel>
      <TextBlock Grid.Column="2" Text="Geometry" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton Classes="mode" GroupName="geometry" Content="Square" IsChecked="{Binding IsSquare}"/><RadioButton Classes="mode" GroupName="geometry" Content="Hex" IsChecked="{Binding IsHex}"/></StackPanel>
      <TextBlock Grid.Column="4" Text="Columns" VerticalAlignment="Center"/><NumericUpDown Grid.Column="5" Value="{Binding Columns}" Minimum="1" Maximum="64" Increment="1" FormatString="0" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="6" Text="Rows" VerticalAlignment="Center"/><NumericUpDown Grid.Column="7" Value="{Binding Rows}" Minimum="1" Maximum="64" Increment="1" FormatString="0" VerticalAlignment="Center"/>
      <Button Grid.Column="9" Content="Load JSON" Click="LoadJsonClicked" VerticalAlignment="Center"/><Button Grid.Column="10" Content="Save JSON" Click="SaveJsonClicked" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="330,10,*" Margin="14,0">
      <Border Classes="panel" Padding="14"><Grid RowDefinitions="Auto,Auto,Auto,*"><StackPanel Spacing="5"><TextBlock Text="Tiles" FontSize="18" FontWeight="SemiBold"/><TextBlock Classes="help" Text="Browse and paint from existing tile definitions."/><TextBox PlaceholderText="Search tiles..." Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="7" Margin="0,12"><Button Classes="primary" Content="All" Padding="10,5"/><Button Content="forest" Padding="10,5"/><Button Content="rough" Padding="10,5"/></StackPanel><TextBlock Grid.Row="2" Text="Forest" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl Grid.Row="3" ItemsSource="{Binding Tiles}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:TilePaletteItem"><Button Width="138" Height="150" Padding="7" Margin="0,0,8,8" Command="{Binding $parent[UserControl].DataContext.SelectBrushCommand}" CommandParameter="{Binding}"><StackPanel Spacing="6"><Image Source="{Binding AssetUri}" Width="118" Height="105" Stretch="UniformToFill"/><TextBlock Text="{Binding Name}" TextAlignment="Center"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
      <Border Grid.Column="2" Classes="panel"><Grid RowDefinitions="*,62"><Grid>
        <views:MapSectionCanvasControl/>
        <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"><RadioButton Classes="mode" GroupName="tool" Content="Paint" IsChecked="True" Command="{Binding SelectToolCommand}" CommandParameter="Paint"/><RadioButton Classes="mode" GroupName="tool" Content="Erase" Command="{Binding SelectToolCommand}" CommandParameter="Erase"/><RadioButton Classes="mode" GroupName="tool" Content="Select" Command="{Binding SelectToolCommand}" CommandParameter="Select"/><RadioButton Classes="mode" GroupName="tool" Content="Pan" Command="{Binding SelectToolCommand}" CommandParameter="Pan"/></StackPanel>
        <Border IsVisible="{Binding HasSelectedCell}" Classes="panel" Width="260" Padding="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Tile instance" FontSize="17" FontWeight="SemiBold"/><Button Grid.Column="1" Content="×" Padding="5,1" Command="{Binding ClosePopupCommand}"/></Grid><TextBlock Classes="help" Text="Source tile"/><TextBlock Text="{Binding SelectedCell.Tile.Name}" FontWeight="SemiBold"/><TextBlock Text="Movement"/><NumericUpDown Value="{Binding SelectedCell.Movement}" Minimum="-20" Maximum="20" Increment="1" FormatString="0"/><CheckBox Content="Blocking" IsChecked="{Binding SelectedCell.IsBlocked}"/><TextBlock Classes="help" Text="These values affect this placed instance only."/><Button Classes="primary" Content="Apply instance" Command="{Binding ClosePopupCommand}"/></StackPanel></Border>
      </Grid><Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="14,8" ColumnSpacing="8"><TextBlock Text="{Binding Status}" Classes="help" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Fit" Command="{Binding FitCommand}"/><Button Grid.Column="2" Content="−" Command="{Binding ZoomOutCommand}"/><TextBlock Grid.Column="3" Text="{Binding ZoomLabel}" VerticalAlignment="Center"/><Button Grid.Column="4" Content="+" Command="{Binding ZoomInCommand}"/></Grid></Grid></Border>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="20,10" ColumnSpacing="10"><TextBlock Text="{Binding CanvasCursorHint}" Foreground="#9DACB8" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Back" Command="{Binding BackCommand}"/><Button Grid.Column="2" Content="Apply section" Classes="primary" Command="{Binding ApplyCommand}"/></Grid>
  </Grid>
</UserControl>
