<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClanIronSim.CoreUx.WorldBuilder.ViewModels"
             xmlns:worldBuilder="using:ClanIronSim.CoreUx.WorldBuilder"
             xmlns:views="using:ClanIronSim.CoreUx.WorldBuilder.Views"
             x:Class="ClanIronSim.CoreUx.WorldBuilder.Views.WorldBuilderHostView"
             x:DataType="worldBuilder:ClanIronWorldBuilderSession">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:WorldBuilderMainMenuViewModel">
      <views:WorldBuilderMainMenuView />
    </DataTemplate>
    <DataTemplate DataType="vm:MapTileEditorViewModel">
      <views:MapTileEditorView />
    </DataTemplate>
    <DataTemplate DataType="vm:MapSectionEditorViewModel">
      <views:MapSectionEditorView />
    </DataTemplate>
  </UserControl.DataTemplates>
  <ContentControl Content="{Binding CurrentViewModel}" />
</UserControl>
