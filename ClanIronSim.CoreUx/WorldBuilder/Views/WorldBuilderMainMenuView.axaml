<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClanIronSim.CoreUx.WorldBuilder.ViewModels"
             x:Class="ClanIronSim.CoreUx.WorldBuilder.Views.WorldBuilderMainMenuView"
             x:DataType="vm:WorldBuilderMainMenuViewModel">
  <Grid Margin="{StaticResource PagePadding}">
    <StackPanel Width="420"
                Spacing="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <TextBlock Text="{Binding Title}"
                 FontSize="{StaticResource TitleFontSize}"
                 FontWeight="SemiBold"
                 TextAlignment="Center"
                 Foreground="{DynamicResource AppForegroundBrush}" />
      <TextBlock Text="{Binding Subtitle}"
                 TextAlignment="Center"
                 Foreground="{DynamicResource MutedForegroundBrush}" />
      <Button Classes="primary"
              Command="{Binding ModifyExistingCommand}"
              Content="Modify Existing"
              HorizontalAlignment="Stretch" />
      <Button Command="{Binding CreateNewCommand}"
              Content="Create Tile"
              HorizontalAlignment="Stretch" />
      <Button Command="{Binding CreateSectionCommand}"
              Content="Create Section"
              HorizontalAlignment="Stretch" />
      <Button Command="{Binding BackCommand}"
              Content="Back"
              HorizontalAlignment="Stretch" />
      <TextBlock Classes="status"
                 Text="{Binding StatusMessage}"
                 TextAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
