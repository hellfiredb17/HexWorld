<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ClanIronSim.CoreUx</AssemblyName>
    <RootNamespace>ClanIronSim.CoreUx</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoreUx\CoreUx.csproj" />
    <ProjectReference Include="..\ClanIronSim\ClanIronSim.csproj" />
    <ProjectReference Include="..\ClanIronSim.HawkNet\ClanIronSim.HawkNet.csproj" />
    <ProjectReference Include="..\HawkNet\HawkNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
