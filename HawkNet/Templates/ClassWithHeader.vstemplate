<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Class with Header</Name>
    <Description>Class file prefilled with project header</Description>
    <ProjectType>CSharp</ProjectType>
    <DefaultName>ClassWithHeader.cs</DefaultName>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true">ClassWithHeader.cs</ProjectItem>
  </TemplateContent>
</VSTemplate>