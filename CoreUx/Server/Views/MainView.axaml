<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:commonViews="using:HawkNet.CoreUx.Common.Views"
        xmlns:commonVm="using:HawkNet.CoreUx.Common.ViewModels"
        xmlns:vm="using:HawkNet.CoreUx.Server.ViewModels"
        xmlns:views="using:HawkNet.CoreUx.Server.Views"
        x:Class="HawkNet.CoreUx.Server.Views.MainView"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1180"
        Height="820"
        MinWidth="860"
        MinHeight="620">
  <Window.DataTemplates>
    <DataTemplate DataType="commonVm:MainMenuViewModel">
      <commonViews:MainMenuView />
    </DataTemplate>
    <DataTemplate DataType="vm:ServerSettingsViewModel">
      <views:ServerSettingsView />
    </DataTemplate>
    <DataTemplate DataType="commonVm:LoadingScreenViewModel">
      <commonViews:LoadingScreenView />
    </DataTemplate>
    <DataTemplate DataType="vm:ChatLobbyViewModel">
      <views:ChatLobbyView />
    </DataTemplate>
    <DataTemplate DataType="vm:ServerMatchViewModel">
      <views:ServerMatchView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid>
    <ContentControl Content="{Binding CurrentViewModel}" />

    <Border IsVisible="{Binding HasErrorPopup}"
            Background="#99000000">
      <Border DataContext="{Binding ErrorPopup}"
              Classes="settings-section"
              Width="440"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding Title}"
                     FontSize="{StaticResource SectionTitleFontSize}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AppForegroundBrush}" />
          <TextBlock Text="{Binding Message}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource AppForegroundBrush}" />
          <TextBlock Text="{Binding Details}"
                     IsVisible="{Binding HasDetails}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedForegroundBrush}" />
          <Button Command="{Binding DismissCommand}"
                  Content="Close"
                  HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
