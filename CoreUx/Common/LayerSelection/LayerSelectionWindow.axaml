<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:HawkNet.CoreUx.Common.LayerSelection"
        x:Class="HawkNet.CoreUx.Common.LayerSelection.LayerSelectionWindow"
        Title="Layer Selection"
        Width="1280"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        CanResize="True"
        WindowDecorations="None">
  <local:LayerSelectionView x:Name="Selector" />
</Window>
