<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:HawkNet.CoreUx.Common.TextureSelection"
        x:Class="HawkNet.CoreUx.Common.TextureSelection.TextureSelectorWindow"
        Title="Texture Selector"
        Width="1280"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        CanResize="True"
        WindowDecorations="None">
  <local:TextureSelectorView x:Name="Selector" />
</Window>
