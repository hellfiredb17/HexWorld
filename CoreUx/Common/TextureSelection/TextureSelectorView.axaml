    <StreamGeometry x:Key="DismissIcon">M4.39705 4.55379L4.46967 4.46967C4.73594 4.2034 5.1526 4.1792 5.44621 4.39705L5.53033 4.46967L12 10.939L18.4697 4.46967C18.7626 4.17678 19.2374 4.17678 19.5303 4.46967C19.8232 4.76256 19.8232 5.23744 19.5303 5.53033L13.061 12L19.5303 18.4697C19.7966 18.7359 19.8208 19.1526 19.6029 19.4462L19.5303 19.5303C19.2641 19.7966 18.8474 19.8208 18.5538 19.6029L18.4697 19.5303L12 13.061L5.53033 19.5303C5.23744 19.8232 4.76256 19.8232 4.46967 19.5303C4.17678 19.2374 4.17678 18.7626 4.46967 18.4697L10.939 12L4.46967 5.53033C4.2034 5.26406 4.1792 4.8474 4.39705 4.55379L4.46967 4.46967L4.39705 4.55379Z</StreamGeometry>
    <StreamGeometry x:Key="ImageOffIcon">M3.28034 2.21968C2.98745 1.92678 2.51257 1.92677 2.21968 2.21966C1.92678 2.51255 1.92677 2.98743 2.21966 3.28032L3.48326 4.54395C3.17684 5.03983 3 5.62426 3 6.25V17.75C3 19.5449 4.45507 21 6.25 21H17.75C18.3757 21 18.96 20.8232 19.4559 20.5169L20.7194 21.7805C21.0123 22.0734 21.4872 22.0734 21.7801 21.7805C22.073 21.4876 22.073 21.0127 21.7801 20.7198L3.28034 2.21968ZM11.1189 12.1797C10.8678 12.2864 10.6322 12.4409 10.4258 12.643L4.60326 18.3437C4.53643 18.1583 4.5 17.9584 4.5 17.75V6.25C4.5 6.0437 4.5357 5.84574 4.60125 5.66196L11.1189 12.1797ZM19.5 6.25V16.3183L20.9993 17.8176C20.9998 17.7951 21 17.7726 21 17.75V6.25C21 4.45507 19.5449 3 17.75 3H6.25C6.2275 3 6.20505 3.00023 6.18265 3.00068L7.68194 4.5H17.75C18.7165 4.5 19.5 5.2835 19.5 6.25ZM18.3305 19.4014C18.1489 19.4653 17.9535 19.5 17.75 19.5H6.25C6.04613 19.5 5.8504 19.4651 5.66845 19.4011L11.4752 13.7148L11.5588 13.644C11.8501 13.4316 12.2596 13.4553 12.5247 13.7148L18.3305 19.4014ZM15.2521 6.5C16.4959 6.5 17.5042 7.50831 17.5042 8.75212C17.5042 9.99592 16.4959 11.0042 15.2521 11.0042C14.0083 11.0042 13 9.99592 13 8.75212C13 7.50831 14.0083 6.5 15.2521 6.5ZM15.2521 8C14.8367 8 14.5 8.33673 14.5 8.75212C14.5 9.1675 14.8367 9.50423 15.2521 9.50423C15.6675 9.50423 16.0042 9.1675 16.0042 8.75212C16.0042 8.33673 15.6675 8 15.2521 8Z</StreamGeometry>
    <StreamGeometry x:Key="CheckIcon">M12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2ZM15.2197 8.96967L10.75 13.4393L8.78033 11.4697C8.48744 11.1768 8.01256 11.1768 7.71967 11.4697C7.42678 11.7626 7.42678 12.2374 7.71967 12.5303L10.2197 15.0303C10.5126 15.3232 10.9874 15.3232 11.2803 15.0303L16.2803 10.0303C16.5732 9.73744 16.5732 9.26256 16.2803 8.96967C15.9874 8.67678 15.5126 8.67678 15.2197 8.96967Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.texture-chrome">
      <Setter Property="Background" Value="#141B21" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.texture-panel">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBlock.texture-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style Selector="Button.icon-button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="9" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
    </Style>
    <Style Selector="Button.material-entry">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="#11181E" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="MinHeight" Value="78" />
    </Style>
    <Style Selector="Button.material-entry:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}" />
    </Style>
    <Style Selector="Button.material-entry.selected">
      <Setter Property="Background" Value="#123346" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.material-entry.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#123346" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.thumbnail-frame">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="60" />
      <Setter Property="Background" Value="#202A32" />
      <Setter Property="BorderBrush" Value="#3A4A56" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="74,*,50" Background="{DynamicResource AppBackgroundBrush}">
    <Border Grid.Row="0" Classes="texture-chrome" Margin="14,12,14,6" PointerPressed="OnHeaderPointerPressed">
      <Grid ColumnDefinitions="*,Auto" Margin="20,0,10,0">
        <TextBlock Text="Texture Selector" FontSize="22" FontWeight="Medium" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="icon-button" Command="{Binding CloseCommand}" ToolTip.Tip="Close">
          <PathIcon Data="{StaticResource DismissIcon}" Width="22" Height="22" Foreground="{DynamicResource AppForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="3*,12,2*" Margin="14,6">
      <Border Grid.Column="0" Classes="texture-panel" ClipToBounds="True">
        <Grid RowDefinitions="58,*">
          <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <TextBlock Classes="texture-title" Text="Model Preview" VerticalAlignment="Center" />
          </Border>
          <Grid Grid.Row="1" Background="#0D1318">
            <ContentControl Content="{Binding PreviewControl}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <Border IsVisible="{Binding HasPreviewInteractionHint}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="18" Padding="12,7" Background="#B30D1318" CornerRadius="5">
              <TextBlock Text="{Binding PreviewInteractionHint}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" />
            </Border>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="texture-panel" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Classes="texture-title" Text="Materials" Margin="4,1,0,14" />
          <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
            <Button Click="OnChooseDirectoryClicked" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" IsEnabled="{Binding IsNotBusy}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource FolderIcon}" Width="23" Height="23" Foreground="{DynamicResource AppForegroundBrush}" />
                <TextBlock Text="Choose Directory" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,9">
              <TextBlock Text="{Binding DirectoryDisplayText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppForegroundBrush}" />
            </Border>
          </StackPanel>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Materials}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:TextureMaterialItemViewModel">
                  <Button Classes="material-entry" Classes.selected="{Binding IsSelected}" Click="OnMaterialClicked" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="64,*,34" ColumnSpacing="14">
                      <Border Classes="thumbnail-frame">
                        <Grid>
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                          <PathIcon Data="{StaticResource ImageOffIcon}" Width="34" Height="34" Foreground="{DynamicResource MutedForegroundBrush}" IsVisible="{Binding IsNone}" />
                        </Grid>
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="14" />
                      <PathIcon Grid.Column="2" Data="{StaticResource CheckIcon}" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding IsSelected}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="texture-chrome" Margin="14,6,14,12">
      <Grid Margin="18,0">
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</UserControl>

