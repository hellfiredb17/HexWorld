<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HawkNet.CoreUx.Common.TextureSelection"
             x:Class="HawkNet.CoreUx.Common.TextureSelection.TextureSelectorView"
             x:DataType="local:TextureSelectorViewModel"
             MinWidth="760"
             MinHeight="520">
  <UserControl.Resources>
    <!-- Path data from Microsoft Fluent UI System Icons, MIT licensed. -->
