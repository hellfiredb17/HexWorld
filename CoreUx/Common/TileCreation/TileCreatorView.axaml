 </UserControl.Resources>
 <UserControl.Styles>
  <Style Selector="Border.tile-chrome, Border.tile-row">
   <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
   <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
   <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.tile-row"><Setter Property="Padding" Value="16" /><Setter Property="Margin" Value="0,0,8,10" /></Style>
  <Style Selector="Border.tile-row.zero"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Border.tile-row.zero TextBlock.tile-layer-title"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style><Style Selector="Border.tile-grip"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Border.tile-grip:pointerover"><Setter Property="Background" Value="#25333E" /></Style>
  <Style Selector="Button.tile-icon"><Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="9" /></Style>
  <Style Selector="Button.tile-remove"><Setter Property="Background" Value="#7D2929" /><Setter Property="BorderBrush" Value="#C34646" /></Style>
  <Style Selector="Button.tile-add"><Setter Property="FontSize" Value="16" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Height" Value="48" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button.tile-preview"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="#0D1318" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
 </UserControl.Styles>
 <ThemeVariantScope RequestedThemeVariant="Dark">
 <Grid RowDefinitions="74,*,Auto" Background="{DynamicResource AppBackgroundBrush}">
  <Border Classes="tile-chrome" Margin="14,12,14,6" PointerPressed="OnHeaderPointerPressed">
   <Grid ColumnDefinitions="*,Auto" Margin="20,0,10,0">
    <TextBlock Text="{Binding HeaderText}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
    <Button Grid.Column="1" Classes="tile-icon" Click="OnCloseClicked" AutomationProperties.Name="Close" ToolTip.Tip="Close">
     <PathIcon Data="{StaticResource DismissIcon}" Width="22" Height="22" />
    </Button>
   </Grid>
  </Border>
  <Border Grid.Row="1" Classes="tile-chrome" Margin="14,6" Padding="12">
   <Grid RowDefinitions="Auto,*,Auto" IsEnabled="{Binding CanEdit}">
    <StackPanel Spacing="12" Margin="0,0,0,10">
     <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Text="Model" VerticalAlignment="Center" />
      <ComboBox x:Name="ModelSelector" Width="200" ItemsSource="{Binding ModelOptions}" SelectedIndex="{Binding SelectedModelIndex, Mode=OneWay}" SelectionChanged="OnModelSelectionChanged" AutomationProperties.Name="Tile model" />
     </StackPanel>
     <Button Classes="tile-add" Click="OnAddAboveClicked"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="↑" /><TextBlock Text="Add Layer" /></StackPanel></Button>
    </StackPanel>
    <ScrollViewer Grid.Row="1" x:Name="LayerScroll" VerticalScrollBarVisibility="Visible" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl x:Name="LayerList" ItemsSource="{Binding Layers}">
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="local:TileLayerItemViewModel">
        <Border Classes="tile-row" Classes.zero="{Binding IsZero}">
         <Grid ColumnDefinitions="32,190,*,48" ColumnSpacing="18">
          <Border Classes="tile-grip" PointerPressed="OnDragPressed" Cursor="SizeAll" ToolTip.Tip="Drag to reorder layer" AutomationProperties.Name="Drag to reorder layer">
           <PathIcon Data="{StaticResource DragIcon}" Width="18" Height="26" Foreground="{DynamicResource MutedForegroundBrush}" IsHitTestVisible="False" />
          </Border>
          <Button Grid.Column="1" Classes="tile-preview" Click="OnPreviewClicked" VerticalAlignment="Top" AutomationProperties.Name="Edit layer" ToolTip.Tip="Open layer editor">
           <Grid RowDefinitions="150,Auto">
            <ContentControl Content="{Binding PreviewControl}" IsHitTestVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <TextBlock Grid.Row="1" Text="Click to edit layer" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center" Margin="4,6" />
           </Grid>
          </Button>
          <Grid Grid.Column="2" ColumnDefinitions="*,1,1.35*" ColumnSpacing="18">
           <StackPanel Spacing="10" Margin="0,12,0,0">
            <TextBlock Classes="tile-layer-title" Text="{Binding HeaderText}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding MaterialName}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" />
           </StackPanel>
           <Border Grid.Column="1" Background="{DynamicResource PanelBorderBrush}" />
           <StackPanel Grid.Column="2" Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="Attributes" Foreground="{DynamicResource MutedForegroundBrush}" />
            <TextBlock Text="No attributes" IsVisible="{Binding HasNoAttributes}" Foreground="{DynamicResource MutedForegroundBrush}" />
            <ItemsControl ItemsSource="{Binding Attributes}">
             <ItemsControl.ItemTemplate><DataTemplate x:DataType="layers:LayerAttributeDefinition">
              <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="8,9">
               <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><TextBlock Text="{Binding Type}" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" /></Grid>
              </Border>
             </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
           </StackPanel>
          </Grid>
          <Button Grid.Column="3" Classes="tile-icon tile-remove" Click="OnRemoveClicked" VerticalAlignment="Top" Margin="0,14,0,0" ToolTip.Tip="Remove layer" AutomationProperties.Name="Remove layer">
           <PathIcon Data="{StaticResource DeleteIcon}" Width="20" Height="20" />
          </Button>
         </Grid>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <Button Grid.Row="2" Classes="tile-add" Click="OnAddBelowClicked" Margin="0,10,0,0"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="↓" /><TextBlock Text="Add Layer" /></StackPanel></Button>
   </Grid>
  </Border>
  <Border Grid.Row="2" Classes="tile-chrome" Margin="14,6,14,12" Padding="14">
   <Grid RowDefinitions="Auto,Auto">
    <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource MutedForegroundBrush}" />
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding CanEdit}">
     <Button Content="Load" FontSize="16" Width="120" Click="OnLoadClicked" />
     <Button Grid.Column="2" Content="Save As" FontSize="16" Classes="primary" Width="140" Click="OnSaveAsClicked" />
    </Grid>
   </Grid>
  </Border>
 </Grid>
 </ThemeVariantScope>
</UserControl>




