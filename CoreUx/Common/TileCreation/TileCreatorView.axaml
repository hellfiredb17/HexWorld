<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:HawkNet.CoreUx.Common.TileCreation" xmlns:layers="using:HawkNet.CoreUx.Common.LayerSelection"
 x:Class="HawkNet.CoreUx.Common.TileCreation.TileCreatorView" x:DataType="local:TileCreatorViewModel" MinWidth="820" MinHeight="520" FontSize="16">
 <UserControl.Resources>
