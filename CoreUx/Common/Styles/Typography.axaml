<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <FontFamily x:Key="AppFontFamily">Inter</FontFamily>
    <x:Double x:Key="TitleFontSize">26</x:Double>
    <x:Double x:Key="SectionTitleFontSize">15</x:Double>
    <x:Double x:Key="BodyFontSize">13</x:Double>
    <x:Double x:Key="LabelFontSize">12</x:Double>
  </Styles.Resources>
</Styles>
