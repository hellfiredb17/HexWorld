<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="SectionPadding">16</Thickness>
    <Thickness x:Key="FieldMargin">0,0,12,12</Thickness>
    <Thickness x:Key="ControlPadding">10,7</Thickness>
    <x:Double x:Key="SectionGap">16</x:Double>
    <x:Double x:Key="FieldWidth">220</x:Double>
    <x:Double x:Key="WideFieldWidth">452</x:Double>
  </Styles.Resources>
</Styles>
