<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Border.settings-section">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="{StaticResource SectionPadding}" />
  </Style>

  <Style Selector="StackPanel.field">
    <Setter Property="Margin" Value="{StaticResource FieldMargin}" />
    <Setter Property="Width" Value="{StaticResource FieldWidth}" />
  </Style>

  <Style Selector="StackPanel.field-wide">
    <Setter Property="Margin" Value="{StaticResource FieldMargin}" />
    <Setter Property="Width" Value="{StaticResource WideFieldWidth}" />
  </Style>
</Styles>
